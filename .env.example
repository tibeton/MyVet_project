# ─────────────────────────────────────────────
# MyVet — Environment variables
# Copy this file to .env.local and fill in the values.
# ─────────────────────────────────────────────

# Telegram bot used to receive appointment requests from the site.
# 1. Create a bot via @BotFather → you get a token like 123456:ABC-DEF...
# 2. Write to the bot once (or add it to a group) and get the chat id.
#    Easiest: message @userinfobot for a personal id, or @getidsbot in a group.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
